    )
    reminder.set_defaults(func=lambda args: reminder.print_help())
    commands = reminder.add_subparsers(dest="reminder_cmd")
    for verb in ("add", "edit"):
        parser = commands.add_parser(
            verb, description=f"{verb.capitalize()} a reminder and preview its next occurrence.",
            formatter_class=argparse.RawTextHelpFormatter,
        )
        add_reminder_options(parser, editing=verb == "edit")
    for verb in ("show", "remove", "pause", "resume", "test"):
        parser = commands.add_parser(verb)
        parser.add_argument("name", type=reminder_name)
        parser.set_defaults(func=cmd_remind)
        if verb == "pause":
            expiry = parser.add_mutually_exclusive_group()
            expiry.add_argument("--for", dest="duration", help="pause for a duration, e.g. 2h, 3d, or 1M (month)")
            expiry.add_argument("--until", help="resume at a date and/or time in the reminder's zone")
    log = commands.add_parser("log")
    log.add_argument("name", nargs="?", type=reminder_name)
    log.add_argument("-n", "--limit", type=positive_int, default=20)
    log.set_defaults(func=cmd_remind)
    listing = commands.add_parser("list")
    listing.set_defaults(func=cmd_remind)
    run = commands.add_parser("run")
    run.set_defaults(func=run_reminder_scheduler)
    deliver = commands.add_parser("_deliver")
    deliver.add_argument("name", type=reminder_name)
    deliver.add_argument("action", choices=("notify", "alarm"))
    deliver.set_defaults(func=deliver_reminder)


def add_reminder_options(add, editing):
    add.set_defaults(func=cmd_remind)
    add.add_argument("name", type=reminder_name, help="unique reminder name, e.g. water")
    schedule = add.add_mutually_exclusive_group(required=not editing)
    schedule.add_argument("--at", type=reminder_time, help="fixed local time, e.g. 09:30 or 9:30am")
    schedule.add_argument("--every", type=positive_duration, help="interval inside the daily window, e.g. 45m")
    add.add_argument("--between", type=reminder_window, metavar="START-END",
                     help="daily clock-time window for --every, e.g. 08:00-21:00")
    first_alert = add.add_mutually_exclusive_group()
    first_alert.add_argument("--at-start", action="store_true", default=None,
                             help="also alert as soon as the daily window opens")
    if editing:
        first_alert.add_argument("--no-at-start", dest="at_start", action="store_false",
                                 help="wait one interval before the first alert of each window")
    start_bound = add.add_mutually_exclusive_group()
    end_bound = add.add_mutually_exclusive_group()
    start_bound.add_argument("--from", dest="from_date", type=reminder_boundary, metavar="DATE",
                     help="first eligible date, optionally with a time")
    end_bound.add_argument("--until", type=reminder_boundary, metavar="DATE",
                     help="last eligible date, optionally with a time (inclusive)")
    if editing:
        start_bound.add_argument("--clear-from", dest="from_date", action="store_const", const="",
                         help="remove the start boundary")
        end_bound.add_argument("--clear-until", dest="until", action="store_const", const="",
                         help="remove the end boundary")
    days = add.add_mutually_exclusive_group()
    days.add_argument("--date", type=reminder_date, help="run once on YYYY-MM-DD with --at")
    days.add_argument("--month-day", type=month_day_number,
                      help="repeat on this day of the month, skipping shorter months")
    days.add_argument("--days", type=reminder_days,
                     help="all (default), weekdays, weekends, or mon,wed,fri")
    add.add_argument("--timezone", type=timezone_policy, metavar="ZONE",
                     help=("system: follow system time zone changes (default)\n"
                           "local-fixed: pin the current system time zone\n"
                           "UTC or Asia/Kolkata: pin a named time zone"))
    add.add_argument("--action", choices=("notify", "alarm"),
                     help="notify: desktop notification (default)\n"
                          "alarm: desktop notification with a ringing alert")


class TickParser(argparse.ArgumentParser):
    def __init__(self, *args, help_rows=(), examples=(), **kwargs):
        super().__init__(*args, **kwargs)
        self.help_rows = help_rows
        self.examples = examples

    def format_help(self):
        if not self.help_rows:
            return super().format_help()
        columns = max(20, shutil.get_terminal_size((80, 24)).columns - 1)
        width = max(len(name) for name, _ in self.help_rows) + 2
        indent = " " * (width + 2)
        commands = []
        for name, description in self.help_rows:
            if columns - len(indent) < 15:
                commands.append("  " + c("1;32", name))
                commands.append(textwrap.fill(description, width=columns,
                                              initial_indent="    ", subsequent_indent="    "))
            else:
                first, *rest = textwrap.wrap(description, width=columns - len(indent))
                commands.append(f"  {c('1;32', name.ljust(width))}{first}")
                commands.extend(indent + line for line in rest)
        command_text = "\n".join(commands)
        options = ""
        if "--version" in self._option_string_actions:
            options = (f"\n{c('1;34', 'Options')}\n"
                       f"  {c('1;32', '-v, --version')}  Show the installed version\n")
        examples = "\n".join(f"  {c('1;36', command)} {options}"
                             for command, options in self.examples)
        arguments = self.usage.removeprefix(self.prog) if self.usage else " <command> [options]"
        return f"""{c('1;34', 'Usage:')} {c('1;35', self.prog)}{arguments}

{c('1;34', 'Commands')}
{command_text}
{options}
{c('1;34', 'Examples')}
{examples}

{self.epilog or 'Run ' + c('1;36', self.prog + ' <command> --help') + ' for options.'}
"""


BASH_COMPLETION = r'''
_tick_complete() {
    local executable=${COMP_WORDS[0]} current=${COMP_WORDS[COMP_CWORD]}
    local item attached=""
    local -a preceding=("${COMP_WORDS[@]:1:COMP_CWORD-1}")
    COMPREPLY=()
    if (( ${#preceding[@]} )) && [[ $current == "=" || ${preceding[-1]} == "=" ]]; then
        if [[ $current == '=' ]]; then
            attached=${preceding[-1]}=
            unset 'preceding[-1]'
            current=""
        else
            unset 'preceding[-1]'
            attached=${preceding[-1]}=
            unset 'preceding[-1]'
        fi
        current=$attached$current
    fi
    while IFS= read -r item; do
        COMPREPLY+=("${item#"$attached"}")
    done < <("$executable" completion _candidates -- "$current" "${preceding[@]}")
    if (( ${#COMPREPLY[@]} )); then
        compopt -o filenames 2>/dev/null
    fi
}
complete -o default -F _tick_complete tick
'''

ZSH_COMPLETION = r'''
_tick_complete() {
    local -a candidates preceding
    preceding=("${words[@]:1:$((CURRENT - 2))}")
    candidates=("${(@f)$("${words[1]}" completion _candidates -- "$PREFIX" "${preceding[@]}")}")
    if (( ${#candidates[@]} )) && [[ -n ${candidates[1]} ]]; then
        compadd -a candidates
    else
        _files
    fi
}
compdef _tick_complete tick
'''


def personal_reminder_names():
    path = DATA_DIR / "reminders.sqlite3"
    if not path.is_file():
        return ()
    try:
        with closing(sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True,
                                     timeout=0.1)) as db:
            return tuple(name for (name,) in db.execute("SELECT name FROM reminders ORDER BY name"))
    except sqlite3.Error:
        return ()


def completion_values(action):
    if action.choices is not None:
        return tuple(str(value) for value in action.choices if not str(value).startswith("_"))
    return {
        "days": ("all", "weekdays", "weekends", *WEEKDAYS),
        "timezone": ("system", "local-fixed", "UTC"),
    }.get(action.dest, ())


def completion_candidates(parser, current, words):
    pending_value = None
    positional_count = 0
    positional_only = False
    index = 0
    while index < len(words):
        word = words[index]
        index += 1
        if word.startswith("--") and words[index:index + 1] == ["="]:
            word += "=" + (words[index + 1] if index + 1 < len(words) else "")
            index += 2
        if pending_value:
            pending_value = None
            continue
        if word == "--" and not positional_only:
            positional_only = True
            continue
        if word.startswith("-") and not positional_only:
            option, equals, _ = word.partition("=")
            action = parser._option_string_actions.get(option)
            if action is not None and action.nargs != 0 and not equals:
                pending_value = action
            continue
        commands = next((action for action in parser._actions
                         if isinstance(action, argparse._SubParsersAction)), None)
        if commands is not None and word in commands.choices:
            parser = commands.choices[word]
            positional_count = 0
        else:
            positional_count += 1

    if pending_value:
        return completion_values(pending_value)
    option, equals, _ = current.partition("=")
    options = parser._option_string_actions
    if equals and option in options and not positional_only:
        return tuple(f"{option}={value}" for value in completion_values(options[option]))
    if current.startswith("-") and not positional_only:
        return tuple(flag for flag, action in options.items() if action.help != argparse.SUPPRESS)
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            return tuple(name for name in action.choices if not name.startswith("_"))
    positionals = [action for action in parser._actions if not action.option_strings]
    if parser.prog == "tick completion" and words == ["completion", "install"]:
        return ("bash", "zsh")
    if positional_count < len(positionals):
        action = positionals[positional_count]
        if (action.type is reminder_name
                and parser.prog.partition(" remind ")[2] in ("show", "edit", "pause", "resume", "remove", "log", "test")):
            return personal_reminder_names()
        return completion_values(action)
    return ()


def install_completion(words):
    shell = words[0] if words else Path(os.environ.get("SHELL", "")).name
    if len(words) > 1 or shell not in ("bash", "zsh"):
        sys.exit("Usage: tick completion install [bash|zsh]")
    directory = Path(os.environ.get("ZDOTDIR") or Path.home()) if shell == "zsh" else Path.home()
    rc = directory / f".{shell}rc"
    source = f"source <(tick completion {shell})"
    setup = [
        "# tick shell completion",
        "if command -v tick >/dev/null 2>&1; then",
    ]
    if shell == "zsh":
        setup.append("    if ! (( $+functions[compdef] )); then autoload -Uz compinit; compinit; fi")
    setup.extend((f"    {source}", "fi"))
    try:
        with rc.open("a+", encoding="utf-8") as stream:
            fcntl.flock(stream, fcntl.LOCK_EX)
            stream.seek(0)
            current = stream.read()
            if source not in (line.strip() for line in current.splitlines()):
                stream.write(("\n" if current else "") + "\n".join(setup) + "\n")
                print(f"Installed {shell} completion in {rc}")
            else:
                print(f"{shell} completion is already configured in {rc}")
    except (OSError, UnicodeError) as error:
        sys.exit(f"Could not update {rc}: {error}")
    print("Open a new shell to use Tab completion.")


def cmd_completion(args, parser):
    if args.shell == "install":
        install_completion(args.words)
        return
    if args.shell in ("bash", "zsh"):
        print(BASH_COMPLETION if args.shell == "bash" else ZSH_COMPLETION, end="")
        return
    if args.words:
        current, *words = args.words
        for match in completion_candidates(parser, current, words):
            if match.startswith(current):
                print(match)


def release_file(path, ref, max_bytes):
    url = f"https://raw.githubusercontent.com/{UPDATE_REPOSITORY}/{ref}/{path}"
    try:
        with urlopen(url, timeout=10) as response:
            data = response.read(max_bytes + 1)
    except HTTPError as error:
        if error.code not in (401, 403, 404) or not shutil.which("gh"):
            raise
        endpoint = f"repos/{UPDATE_REPOSITORY}/contents/{path}?ref={ref}"
        result = subprocess.run(["gh", "api", endpoint, "--jq", ".content"],
                                capture_output=True, timeout=15)
        if result.returncode:
            raise ValueError("release is unavailable. For a private repository, log in to GitHub with gh first.") from None
        data = base64.b64decode(b"".join(result.stdout.split()), validate=True)
    if len(data) > max_bytes:
        raise ValueError(f"{path} exceeds the download size limit")
    return data


def release_version(value):
    if not isinstance(value, str) or not re.fullmatch(r"[0-9]{1,6}\.[0-9]{1,6}\.[0-9]{1,6}", value):
        raise ValueError("invalid release version")
    return tuple(map(int, value.split(".")))


def executable_version(source):
    match = re.search(rb'^VERSION = "([0-9.]+)"$', source, re.MULTILINE)
    if not match:
        raise ValueError("installed executable has no version marker")
    return match[1].decode("ascii")


def replace_tick(path, source, mode):
    with tempfile.NamedTemporaryFile(dir=path.parent, prefix=".tick-update-", delete=False) as output:
        temporary = Path(output.name)
        try:
            output.write(source)
            os.fchmod(output.fileno(), mode)
            output.flush()
            os.fsync(output.fileno())
            output.close()
            temporary.replace(path)
        finally:
            temporary.unlink(missing_ok=True)


def restart_tick_service(command):
    subprocess.run([*command, "restart", SERVICE_NAME], check=True, timeout=30)
    for _ in range(3):
        time.sleep(0.5)
        subprocess.run([*command, "is-active", "--quiet", SERVICE_NAME], check=True, timeout=10)


def install_tick_release(path, previous, payload, version):
    service = shutil.which("systemctl")
    command = [service, "--user"] if service else None
    active = command and subprocess.run(
        [*command, "is-active", "--quiet", SERVICE_NAME], timeout=10
    ).returncode == 0
    mode = stat.S_IMODE(path.stat().st_mode)
    replace_tick(path, payload, mode)
    if active:
        try:
            restart_tick_service(command)
        except (OSError, subprocess.SubprocessError) as error:
            replace_tick(path, previous, mode)
            try:
                restart_tick_service(command)
            except (OSError, subprocess.SubprocessError):
                raise ValueError("restored the previous executable, but the reminder service did not restart") from error
            raise ValueError("restart failed, so the previous version was restored and restarted") from error
    print(f"Updated tick to {version}." + (" Reminder service restarted." if active else ""))


def cmd_update(_args):
    path = Path(__file__).resolve()
    try:
        DATA_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
        with (DATA_DIR / "update.lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            previous = path.read_bytes()
            installed = executable_version(previous)
            metadata = json.loads(release_file("release.json", "main", 4096))
            if not isinstance(metadata, dict):
                raise ValueError("invalid release metadata")
            version = metadata.get("version")
            if release_version(version) <= release_version(installed):
                print(f"tick {installed} is up to date.")
                return
            checksum = metadata.get("sha256")
            if not isinstance(checksum, str) or not re.fullmatch(r"[a-f0-9]{64}", checksum):
                raise ValueError("invalid release checksum")
            payload = release_file("tick", f"v{version}", 2 * 1024 * 1024)
            if hashlib.sha256(payload).hexdigest() != checksum:
                raise ValueError("release checksum does not match")
            if executable_version(payload) != version:
                raise ValueError("release executable version does not match")
            compile(payload, str(path), "exec")
            install_tick_release(path, previous, payload, version)
    except BlockingIOError:
        sys.exit("Another tick update is already running.")
    except (OSError, ValueError, SyntaxError, subprocess.SubprocessError) as error:
        sys.exit(f"Update failed: {error}")


