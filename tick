def load_sessions():
    out = []
    try:
        with open(LOG_FILE) as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        out.append(json.loads(line))
                    except ValueError:
                        pass
    except OSError:
        pass
    return out


def today_seconds():
    t = date.today().isoformat()
    return sum(s["seconds"] for s in load_sessions() if s["start"][:10] == t)


def record(start, secs, subject, kind, completed):
    """Append a focus session to the log. Ignores anything under a minute."""
    if secs < 60:
        return 0
    before = today_seconds()
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    rec = {
        "start": start.isoformat(timespec="seconds"),
        "end": datetime.now().isoformat(timespec="seconds"),
        "seconds": int(secs),
        "subject": subject or "",
        "kind": kind,
        "completed": completed,
    }
    with open(LOG_FILE, "a") as f:
        f.write(json.dumps(rec) + "\n")
    goal = CFG["goal_min"] * 60
    if start.date() == date.today() and goal and before < goal <= before + secs:
        notify("Daily goal reached", f"You hit {fmt_dur(goal)} today. Nice.")
    return secs


# ---------- formatting ----------

def fmt_clock(sec):
    sec = max(0, int(sec))
    h, r = divmod(sec, 3600)
    m, s = divmod(r, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"


def fmt_dur(sec):
    sec = int(sec)
    h, r = divmod(sec, 3600)
    m = r // 60
    if h:
        return f"{h}h {m:02d}m"
    if m:
        return f"{m}m"
    return f"{sec}s"


def parse_duration(s):
    """'25' -> 25 min, '90s', '1h30m', '45m', '1:30:00', '25:00'."""
    s = str(s).strip().lower()
    try:
        if re.fullmatch(r"\d+(\.\d+)?", s):
            return int(float(s) * 60)
        if ":" in s:
            fields = s.split(":")
            if not all(part.isdecimal() for part in fields):
                raise ValueError
            p = list(map(int, fields))
            if any(part >= 60 for part in p[1:]):
                raise ValueError
            if len(p) == 2:
                return p[0] * 60 + p[1]
            if len(p) == 3:
                return p[0] * 3600 + p[1] * 60 + p[2]
            raise ValueError
        m = re.fullmatch(r"(?:(\d+)h)?\s*(?:(\d+)m)?\s*(?:(\d+)s)?", s)
        if not m or not any(m.groups()):
            raise ValueError
        h, mi, se = (int(x or 0) for x in m.groups())
        return h * 3600 + mi * 60 + se
    except (ValueError, OverflowError):
        raise argparse.ArgumentTypeError(f"bad duration {s!r} (try 25, 45m, 1h30m, 90s)")


def positive_duration(value):
    seconds = parse_duration(value)
    if seconds <= 0:
        raise argparse.ArgumentTypeError("duration must be at least one second")
    return seconds


def nonnegative_int(value):
    number = int(value)
    if number < 0:
        raise argparse.ArgumentTypeError("must be zero or greater")
    return number


def positive_int(value):
    number = nonnegative_int(value)
    if number == 0:
        raise argparse.ArgumentTypeError("must be at least one")
    return number


def session_label(value):
    if len(value) > 120 or len(value.split()) > 12:
        raise argparse.ArgumentTypeError("use at most 12 words and 120 characters")
    return " ".join(value.split())


def sound_path(value):
    path = Path(value).expanduser().resolve()
    if not path.is_file() or not os.access(path, os.R_OK):
        raise argparse.ArgumentTypeError(f"cannot read sound file: {path}")
    return str(path)


