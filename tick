            ("install bash|zsh", "Install for a specific shell"),
            ("bash", "Print the Bash completion script"),
            ("zsh", "Print the Zsh completion script"),
        ),
        examples=(("tick completion", "install"),
                  ("tick completion", "install bash")),
    )
    completion.add_argument("shell", choices=("bash", "zsh", "install", "_candidates"),
                            metavar="{bash,zsh,install}")
    completion.add_argument("words", nargs="*", help=argparse.SUPPRESS)
    completion.set_defaults(func=lambda args: cmd_completion(args, p))
    study_parser = sub.add_parser(
        "study", prog="tick study", usage="tick study <command> [options]",
        help="time and record study sessions",
