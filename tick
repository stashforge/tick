# ---------- config / log ----------

def load_config():
    cfg = dict(DEFAULTS)
    try:
        saved = json.loads(CONF_FILE.read_text())
        if isinstance(saved, dict):
            for key, default in DEFAULTS.items():
                value = saved.get(key, default)
                minimum = 1 if key in ("work_min", "cycles") else 0
                if type(value) is type(default) and (type(value) is not int or value >= minimum):
                    cfg[key] = value
    except (OSError, ValueError):
        pass
    return cfg


def save_config(cfg):
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=CONF_DIR, delete=False) as f:
        temp = Path(f.name)
        try:
            f.write(json.dumps(cfg, indent=2) + "\n")
            f.close()
            temp.replace(CONF_FILE)
        finally:
            temp.unlink(missing_ok=True)


